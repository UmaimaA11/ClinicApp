<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/user_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/baseline_person_24"
            app:shapeAppearanceOverlay="@style/CircleAppearance"
            app:tint="@color/mercredi"
            android:background="@color/jeudi"
            android:padding="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_user_name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/mars"/>

            <TextView
                android:id="@+id/tv_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_user_email"
                android:textSize="14sp"
                android:textColor="@color/avril"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tv_user_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/placeholder_role"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/mercredi"
                android:layout_marginTop="6dp"
                android:background="@drawable/card_rounded"
                android:backgroundTint="@color/jeudi"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_edit_user"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_star"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/vendredi"
                android:contentDescription="@string/content_description_edit"
                android:scaleType="centerInside"
                android:padding="4dp"/>

            <ImageButton
                android:id="@+id/btn_delete_user"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_star"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/septembre"
                android:contentDescription="@string/content_description_delete"
                android:scaleType="centerInside"
                android:padding="4dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
